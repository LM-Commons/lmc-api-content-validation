{
  "name": "lm-commons/lmc-api-content-validation",
  "description": "API Tools for validating content",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Eric Richer",
      "email": "eric.richer@vistoconsulting.com"
    }
  ],
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0"
  },
  "require-dev": {
    "laminas/laminas-coding-standard": "^3.1",
    "phpunit/phpunit": "^12.5",
    "psalm/plugin-phpunit": "^0.19.5",
    "vimeo/psalm": "^6.16"
  },
  "autoload": {
    "psr-4": {
      "Lmc\\Api\\ContentValidation\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LmcTest\\Api\\ContentValidation\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.3.99"
    }
  },
  "extra": {
    "laminas": {
      "config-provider": "Lmc\\Api\\ContentValidation\\ConfigProvider"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@test"
    ],
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-clover ./build/logs/clover.xml",
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "test-coverage-html": "phpunit --coverage-html ./build/html",
    "static-analysis": "psalm --shepherd --stats"
  }
}
